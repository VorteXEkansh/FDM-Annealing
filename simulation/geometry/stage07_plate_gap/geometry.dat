/BATCH
/PREP7
! Stage 7 geometry only. Units: mm. No mesh, material, load, or solve.
LSP=60.000000000
WSP=10.000000000
HSP=4.000000000
LPL=70.000000000
WPL=20.000000000
TPL=5.000000000
GAP=0.040000000
XM=(LPL-LSP)/2
YM=(WPL-WSP)/2
BLOCK,0,LPL,0,WPL,-TPL-GAP/2,-GAP/2
VSEL,S,VOLU,,1
CM,LOWER_PLATE,VOLU
ALLSEL,ALL
BLOCK,XM,XM+LSP,YM,YM+WSP,0,HSP
VSEL,S,VOLU,,2
CM,SPECIMEN,VOLU
ALLSEL,ALL
BLOCK,0,LPL,0,WPL,HSP+GAP/2,HSP+GAP/2+TPL
VSEL,S,VOLU,,3
CM,UPPER_PLATE,VOLU
ALLSEL,ALL
CM,FIXTURE_PLATES,VOLU
*GET,NVOL,VOLU,0,COUNT
/COM,STAGE7_EXPECTED_VOLUMES=3
/COM,STAGE7_TOTAL_GAP_MM=0.040000000
/COM,STAGE7_GAMMA=0.010000000
VSUM
SAVE,stage07_plate_gap,db
/EXIT,NOSAVE
