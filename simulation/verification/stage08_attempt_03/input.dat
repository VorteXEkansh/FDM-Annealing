/BATCH
/FILNAME,stage08_thermal
/TITLE,Stage 8 analytical plane-wall thermal verification only
/PREP7
ET,1,70
MP,KXX,1,0.5
MP,KYY,1,0.5
MP,KZZ,1,0.5
MP,C,1,1000
MP,DENS,1,1000
BLOCK,0,0.001,0,0.001,0,0.01
MSHAPE,0,3D
MSHKEY,1
ESIZE,0.00025
VMESH,ALL
ALLSEL,ALL
FINISH
/SOLU
ANTYPE,TRANS
TRNOPT,FULL
AUTOTS,OFF
*DIM,TS,ARRAY,9
TS(1)=150
TS(2)=300
TS(3)=450
TS(4)=600
TS(5)=900
TS(6)=1050
TS(7)=1200
TS(8)=1500
TS(9)=1800
OUTRES,ERASE
OUTRES,NSOL,%TS%
TUNIF,20
ASEL,S,LOC,Z,0
ASEL,A,LOC,Z,0.01
SFA,ALL,1,CONV,5,20
ALLSEL,ALL
TIME,1e-6
KBC,1
NSUBST,1,1,1
SOLVE
ASEL,S,LOC,Z,0
ASEL,A,LOC,Z,0.01
SFA,ALL,1,CONV,5,80
ALLSEL,ALL
TIME,300
KBC,0
DELTIM,1,1,1,ON
SOLVE
ASEL,S,LOC,Z,0
ASEL,A,LOC,Z,0.01
SFA,ALL,1,CONV,5,80
ALLSEL,ALL
TIME,900
KBC,0
DELTIM,1,1,1,ON
SOLVE
ASEL,S,LOC,Z,0
ASEL,A,LOC,Z,0.01
SFA,ALL,1,CONV,5,20
ALLSEL,ALL
TIME,1200
KBC,0
DELTIM,1,1,1,ON
SOLVE
ASEL,S,LOC,Z,0
ASEL,A,LOC,Z,0.01
SFA,ALL,1,CONV,5,20
ALLSEL,ALL
TIME,1800
KBC,0
DELTIM,1,1,1,ON
SOLVE
FINISH
/POST1
ALLSEL,ALL
NSEL,S,LOC,X,0.0005
NSEL,R,LOC,Y,0.0005
NSEL,R,LOC,Z,0.005
*GET,CNODE,NODE,0,NUM,MIN
ALLSEL,ALL
*CFOPEN,solver_center_temperature,csv
*VWRITE,'requested_time_s,solver_time_s,ansys_center_temperature_C'
(A65)
*DO,II,1,9
TREQ=TS(II)
SET,,,,,TREQ
*GET,TNOW,ACTIVE,0,SET,TIME
*GET,TC,NODE,CNODE,TEMP
*VWRITE,TREQ,TNOW,TC
(F16.6,',',F16.6,',',E24.16)
*ENDDO
*CFCLOS
ALLSEL,ALL
*GET,NN,NODE,0,COUNT
*GET,NE,ELEM,0,COUNT
*CFOPEN,mesh_counts,csv
*VWRITE,'nodes,elements,center_node'
(A30)
*VWRITE,NN,NE,CNODE
(F16.0,',',F16.0,',',F16.0)
*CFCLOS
FINISH
/EXIT,NOSAVE
